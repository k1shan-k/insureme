# Required for durable risk-assessment intake.
# The endpoint must persist or enqueue accepted submissions and return 2xx.
RISK_ASSESSMENT_WEBHOOK_URL=https://your-secure-intake.example/webhook

# Optional bearer token sent to the intake webhook.
RISK_ASSESSMENT_WEBHOOK_TOKEN=replace-with-a-secret

# Optional external policyholder portal. If omitted, access guidance is shown.
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://portal.example.com

# Optional production contact destinations. Leave unset rather than using reserved placeholders.
NEXT_PUBLIC_UNDERWRITING_EMAIL=underwriting@your-domain.example
NEXT_PUBLIC_CAREERS_EMAIL=careers@your-domain.example

NEXT_PUBLIC_UNDERWRITING_PHONE=+1-000-000-0000
NEXT_PUBLIC_OFFICE_ADDRESS=Your regulated entity office address

# Required for durable online claims-notification intake.
# The HTTPS endpoint must persist or enqueue an accepted notification before returning 2xx.
CLAIMS_NOTIFICATION_WEBHOOK_URL=https://your-secure-intake.example/claims

# Required independent bearer token sent only to the claims-notification webhook.
CLAIMS_NOTIFICATION_WEBHOOK_TOKEN=replace-with-a-separate-secret