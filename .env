# Preferred production canonical origin. Set the verified public HTTPS origin without a trailing path.
# On Vercel, a blank value falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
# Non-Vercel production builds must set this value.
NEXT_PUBLIC_SITE_URL=

# Optional public entity and contact values. Leave blank until verified and approved.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_UNDERWRITING_EMAIL=
NEXT_PUBLIC_CLIENT_SERVICES_EMAIL=
NEXT_PUBLIC_CAREERS_EMAIL=
NEXT_PUBLIC_UNDERWRITING_PHONE=
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_CLIENT_PORTAL_URL=

# Required server-side Supabase project origin, for example https://your-project.supabase.co.
# Production requires the hosted project origin https://<project-ref>.supabase.co with no path,
# query, fragment, credentials, or custom port.
SUPABASE_URL=

# Required server-side Supabase secret key. Prefer the current sb_secret_* key format.
# Publishable/anon keys are rejected and cannot write this RLS-protected intake table.
# This key bypasses row-level security: keep it out of source control and never expose it through
# any NEXT_PUBLIC_* variable or browser code.
SUPABASE_SECRET_KEY=

# Required for production claims intake.
# The HTTPS receiver must durably persist or enqueue each accepted notification before returning 2xx
# and must deduplicate retries using the Idempotency-Key header.
CLAIMS_NOTIFICATION_WEBHOOK_URL=

# Required independent server-side bearer token for claims delivery. Keep secret and do not expose
# it through any NEXT_PUBLIC_* variable.
CLAIMS_NOTIFICATION_WEBHOOK_TOKEN=

# Optional, Netlify only. Set to "true" to route intake to Netlify Forms instead of Supabase
# (assessments) and instead of the claims webhook (claims). Requires public/__forms.html, which
# is what Netlify scans at deploy time to detect the forms and their field names.
#
# Supabase takes precedence wherever it is configured, because it is the only sink that can
# deduplicate an unchanged retry by submission_id. With Netlify Forms a retry creates a second
# submission carrying the same reference, so operations staff must dedupe on that value.
NETLIFY_FORMS_ENABLED=true
